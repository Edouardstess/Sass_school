# Copy to .env and fill in. Never commit the filled-in file.

# --- Database -------------------------------------------------------------
SQL_PASSWORD=change_me_strong_password
STED_CONNECTION_STRING=Server=sqlserver,1433;Database=StedRestaurantOs;User Id=sa;Password=change_me_strong_password;TrustServerCertificate=True

# --- Authentication -------------------------------------------------------
# At least 32 characters. Generate one, do not invent one:
#   openssl rand -base64 48
JWT__SIGNINGKEY=
JWT__ISSUER=sted-restaurant-os
JWT__AUDIENCE=sted-restaurant-os-api

# --- Web ------------------------------------------------------------------
CORS__ALLOWEDORIGINS__0=http://localhost:5173
ASPNETCORE_ENVIRONMENT=Development
