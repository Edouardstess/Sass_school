# Test environment. Copy to `.env` in CI (see .github/workflows/backend.yml).
APP_NAME=SchoolFlow
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=fr
FRONTEND_URL=http://localhost:3000

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=schoolflow_test
DB_USERNAME=schoolflow
DB_PASSWORD=schoolflow

CACHE_STORE=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
MAIL_MAILER=array
FILESYSTEM_DISK=local
BCRYPT_ROUNDS=4

# Every external integration is off in tests: a suite that can reach a payment
# provider is a suite that can charge someone.
AI_ENABLED=false
MONCASH_ENABLED=false
NATCASH_ENABLED=false
STRIPE_ENABLED=false
SMS_DRIVER=log
WHATSAPP_DRIVER=log
