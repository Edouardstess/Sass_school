###############################################################################
# SchoolFlow — shared environment template
#
# Copy to `.env` at the repository root before running `docker compose up -d`.
# Docker Compose injects these values into the backend, worker, scheduler and
# frontend services. Never commit the resulting `.env`.
###############################################################################

# --- Application ------------------------------------------------------------
APP_NAME=SchoolFlow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en

# Public URL of the Next.js frontend. Used to build links inside e-mails,
# password-reset messages and document verification URLs.
FRONTEND_URL=http://localhost:3000

# Comma separated list of origins allowed to call the API with credentials.
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Database ---------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=schoolflow
DB_USERNAME=schoolflow
DB_PASSWORD=change-me-in-production

# --- Cache / queue / session ------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# --- Object storage (MinIO in development, any S3-compatible in production) --
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=schoolflow
AWS_SECRET_ACCESS_KEY=change-me-in-production
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=schoolflow
AWS_ENDPOINT=http://minio:9000
AWS_URL=http://localhost:9000/schoolflow
AWS_USE_PATH_STYLE_ENDPOINT=true

# --- Mail -------------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=no-reply@schoolflow.test
MAIL_FROM_NAME="${APP_NAME}"

# --- Security ---------------------------------------------------------------
# Number of failed logins before an account/IP pair is throttled.
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_SECONDS=900
# Sanctum personal access token lifetime, in minutes (null = never expires).
SANCTUM_TOKEN_EXPIRATION=10080

# --- Payment gateways -------------------------------------------------------
# Each provider is optional. When credentials are absent the provider is
# reported as unavailable instead of silently pretending to work.
PAYMENTS_DEFAULT_CURRENCY=HTG

MONCASH_ENABLED=false
MONCASH_CLIENT_ID=
MONCASH_CLIENT_SECRET=
MONCASH_MODE=sandbox
MONCASH_WEBHOOK_SECRET=

NATCASH_ENABLED=false
NATCASH_MERCHANT_ID=
NATCASH_API_KEY=
NATCASH_WEBHOOK_SECRET=

STRIPE_ENABLED=false
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# --- Messaging providers ----------------------------------------------------
SMS_DRIVER=log
SMS_FROM=SchoolFlow
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

WHATSAPP_DRIVER=log
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=

# --- AI assistant -----------------------------------------------------------
# The assistant only calls whitelisted, authorization-checked tools. It never
# receives raw SQL access. Leave the key empty to disable the feature.
AI_ENABLED=false
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=

# --- Frontend (Next.js) -----------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=fr

# --- Docker host port mapping ----------------------------------------------
NGINX_PORT=8000
FRONTEND_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILPIT_PORT=8025
